
@page
@model IndexModel

@{
    ViewData["Title"] = "DevOps CI/CD Lab";
}

<div class="text-center mt-5">
    <h1 class="display-4">DevOps CI/CD Lab</h1>

    <h2 class="mt-4">Application deployed successfully!</h2>

    <p class="lead mt-3">
        ASP.NET Core 10 running on IIS
    </p>

    <div class="mt-4">
        <span class="badge bg-success">Application Online</span>
        <span class="badge bg-primary">Environment: Development</span>
    </div>

    <hr class="my-4" />

    <p>
        Automated deployment using GitHub Actions
        and a self-hosted Windows runner.
    </p>
</div>

